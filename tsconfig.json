{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // class-validator's @IsInt() etc. on request DTOs. emitDecoratorMetadata
    // stays off: tsx/vitest (esbuild) can't emit it, and nested types are
    // named with @Type(() => X) instead.
    "experimentalDecorators": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
